{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ImageConfig": {
    "ImageFolderPath": "YOUR_ABSOLUTE_PATH_TO_IMAGES_FOLDER"
  },
  "AllowedHosts": "*",
  "CdnHost": "http://localhost:5038",
  "ImgUrl": "assets/images",
  "PathBase": "http://localhost:5038",
  "ConnectionString": "Host=localhost;Port=5432;Database=pixchat_db;Username=postgres;Password=your_password",
  "Jwt": {
    "Key": "YOUR_SECRET_SUPER_LONG_KEY_AT_LEAST_32_CHARS",
    "Issuer": "PixChat.API",
    "Audience": "PixChat.Clients"
  },
  "MailJet": {
    "ApiKey": "YOUR_MAILJET_API_KEY",
    "ApiSecret": "YOUR_MAILJET_API_SECRET",
    "FromEmail": "no-reply@yourdomain.com",
    "FromName": "PixChat Support"
  }
}
